<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.hhldiniz.cotacao_direta</id>
  <name>Cotação Direta</name>
  <name xml:lang="en">Direct Quote</name>
  <name xml:lang="es">Cotización Directa</name>
  <summary>Cotação das principais moedas frente ao real</summary>
  <summary xml:lang="en">Exchange rates for the main currencies against the Brazilian real</summary>
  <summary xml:lang="es">Cotización de las principales monedas frente al real brasileño</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>

  <developer id="io.github.hhldiniz">
    <name>hhldiniz</name>
  </developer>

  <url type="homepage">https://github.com/hhldiniz/cotacao_direta</url>
  <url type="bugtracker">https://github.com/hhldiniz/cotacao_direta/issues</url>
  <url type="vcs-browser">https://github.com/hhldiniz/cotacao_direta</url>

  <description>
    <p>
      O Cotação Direta mostra a cotação das principais moedas frente ao real,
      com histórico, conversão entre moedas e alertas de câmbio.
    </p>
    <p xml:lang="en">
      Direct Quote shows exchange rates for the main currencies against the
      Brazilian real, with history, currency conversion and exchange rate
      alerts.
    </p>
    <p xml:lang="es">
      Cotización Directa muestra la cotización de las principales monedas
      frente al real brasileño, con historial, conversión entre monedas y
      alertas de cambio.
    </p>
  </description>

  <launchable type="desktop-id">io.github.hhldiniz.cotacao_direta.desktop</launchable>

